# Public API origins only; do not include /api or a trailing slash.
# These values are embedded in the app bundle and must not contain secrets.

# Optional during local development. If omitted, Expo automatically uses the
# Metro host IP with port 5000 (for example http://192.168.1.20:5000).
# EXPO_PUBLIC_DEV_API_URL=http://192.168.1.20:5000

# Used by preview and production builds. eas.json also defines this value.
EXPO_PUBLIC_PRODUCTION_API_URL=https://insplit-server.onrender.com
