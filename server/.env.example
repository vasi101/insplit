# Environment Variables for Insplit Server
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/insplit?retryWrites=true&w=majority

# JWT (required)
JWT_ACCESS_SECRET=your_super_secret_access_key_here_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional — only needed for image upload via POST /api/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Transactional email (Choose Resend OR Gmail App Password)
# Option A: Gmail SMTP (Personal / Workspace Gmail)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Resend (API)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Insplit <no-reply@your-domain.com>

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081,http://localhost:5173,http://localhost:3000
