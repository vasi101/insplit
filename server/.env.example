# Environment Variables for Insplit Server
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/insplit?retryWrites=true&w=majority

# JWT (required)
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional — only needed for image upload via POST /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (choose ONE provider; Gmail takes precedence)
# If neither provider is configured, development prints OTPs to the terminal
# and production returns EMAIL_NOT_CONFIGURED.
# Option A: Gmail SMTP (Personal / Workspace Gmail)
GMAIL_USER=
# Requires Google two-step verification. Use an App Password, not your normal password.
GMAIL_APP_PASSWORD=

# Option B: Resend (API)
RESEND_API_KEY=
# With Resend, this sender domain must be verified (except Resend's test sender).
EMAIL_FROM=

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081,http://localhost:5173,http://localhost:3000
